rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "A873gDM5ZoO52w1BpPTMYePyvzN2";
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll([
        'name','email','phone','eventType','date','guests',
        'budget','venue','notes','shortlist','status','createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 2
      && request.resource.data.name.size() <= 100
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 254
      && request.resource.data.phone is string
      && request.resource.data.phone.size() >= 7
      && request.resource.data.phone.size() <= 20
      && request.resource.data.eventType is string
      && request.resource.data.eventType.size() <= 80
      && request.resource.data.date is string
      && request.resource.data.date.size() <= 40
      && request.resource.data.budget is string
      && request.resource.data.budget.size() <= 100
      && request.resource.data.venue is string
      && request.resource.data.venue.size() <= 250
      && request.resource.data.notes is string
      && request.resource.data.notes.size() <= 2000
      && request.resource.data.guests is number
      && request.resource.data.guests >= 1
      && request.resource.data.guests <= 100000
      && request.resource.data.shortlist is list
      && request.resource.data.shortlist.size() <= 30
      && request.resource.data.status == 'New'
      && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
